---
import './Experience.css';
import { experiences } from '../data/experiences';
---

<section id="experiencia" class="experience">
  <div class="experience__header">
    <span class="experience__number">04</span>
    <h2 class="experience__title">Experiencia</h2>
  </div>

  {experiences.map((experience) => (
    <div class:list={['experience__item', experience.featured && 'experience__item--featured']}>
      <span class="experience__year">{experience.period}</span>
      <div class="experience__content">
        <h3 class="experience__role">
          {experience.role} · {experience.company}
        </h3>
        <p class="experience__description">{experience.description}</p>
      </div>
    </div>
  ))}
</section>
