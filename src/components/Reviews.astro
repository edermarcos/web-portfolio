---
import './Reviews.css';
import { reviews } from '../data/reviews';
---

<section id="resenas" class="reviews">
  <div class="reviews__header">
    <span class="reviews__number">05</span>
    <h2 class="reviews__title">Reseñas</h2>
  </div>

  <p class="reviews__notice">
    Estos 10 textos son ejemplos ficticios para mostrar el formato; no son testimonios reales.
  </p>

  <div class="reviews__list" id="reviewsList">
    {reviews.map((review, index) => (
      <article class="reviews__card" data-review-id={review.id} hidden={index >= 5}>
        <span class="reviews__quote-mark" aria-hidden="true">
          “
        </span>
        <div>
          <p class="reviews__description">{review.quote}</p>
          <p class="reviews__example-label">
            Ejemplo ficticio {String(index + 1).padStart(2, '0')}
          </p>
        </div>
      </article>
    ))}
  </div>

  <nav class="reviews__pagination" aria-label="Paginación de reseñas">
    <button class="reviews__page-button" id="reviewsPrevious" type="button" disabled>
      Anterior
    </button>
    <span class="reviews__page-status" id="reviewsPageStatus" aria-live="polite">
      Página 1 de 2
    </span>
    <button class="reviews__page-button" id="reviewsNext" type="button">
      Siguiente
    </button>
  </nav>

  <a
    class="reviews__cta"
    href="mailto:eder.marcos.lara@gmail.com?subject=Rese%C3%B1a%20para%20el%20portafolio"
  >
    Compartir una reseña real →
  </a>
</section>

<script>
  const pageSize = 5;
  const reviewCards = Array.from(document.querySelectorAll<HTMLElement>('.reviews__card'));
  const previousButton = document.querySelector<HTMLButtonElement>('#reviewsPrevious');
  const nextButton = document.querySelector<HTMLButtonElement>('#reviewsNext');
  const pageStatus = document.querySelector<HTMLSpanElement>('#reviewsPageStatus');

  if (!previousButton || !nextButton || !pageStatus) {
    throw new Error('Falta el marcado requerido para la paginación de reseñas.');
  }

  const totalPages = Math.ceil(reviewCards.length / pageSize);
  let currentPage = 1;

  function renderReviews() {
    const firstVisibleIndex = (currentPage - 1) * pageSize;

    reviewCards.forEach((card, index) => {
      card.hidden = index < firstVisibleIndex || index >= firstVisibleIndex + pageSize;
    });

    previousButton.disabled = currentPage === 1;
    nextButton.disabled = currentPage === totalPages;
    pageStatus.textContent = `Página ${currentPage} de ${totalPages}`;
  }

  previousButton.addEventListener('click', () => {
    currentPage = Math.max(1, currentPage - 1);
    renderReviews();
  });
  nextButton.addEventListener('click', () => {
    currentPage = Math.min(totalPages, currentPage + 1);
    renderReviews();
  });

  renderReviews();
</script>
