---
import './Studio.css';
---

<section id="em-dev-studio" class="studio">
  <div class="studio__content">
    <p class="studio__label">// mi consultora</p>
    <h2 class="studio__title">
      Ideas claras.
      <br />
      Software que impulsa.
    </h2>
    <p class="studio__description">
      EM Dev Studio es mi consultora de desarrollo de software. Acompaño a personas y equipos a
      convertir sus ideas en productos digitales útiles, cuidando cada detalle desde el diseño hasta
      la implementación.
    </p>
    <a class="studio__cta" href="mailto:eder.marcos.lara@gmail.com?subject=EM%20Dev%20Studio">
      Hablemos de tu proyecto →
    </a>
  </div>
  <div class="studio__mark" aria-hidden="true">
    <span>EM</span>
    <span>DEV STUDIO</span>
    <span class="studio__mark-dot"></span>
  </div>
</section>
