---
import './Skills.css';
---

<section id="habilidades" class="skills">
  <div class="skills__header">
    <span class="skills__number">01</span>
    <h2 class="skills__title">Habilidades</h2>
    <span class="skills__comment">// herramientas con las que trabajo a diario</span>
  </div>

  <div class="skills__grid">
    <div class="skills__category">
      <p class="skills__category-label">// front-end</p>
      <div class="skills__list">
        <span class="skills__item">Angular · React</span>
        <span class="skills__item">TypeScript · JavaScript ES6+</span>
        <span class="skills__item">HTML5 · CSS3 · SCSS</span>
        <span class="skills__item">RxJS · NgRx</span>
        <span class="skills__item skills__item--last">Ionic</span>
      </div>
    </div>

    <div class="skills__category">
      <p class="skills__category-label">// arquitectura y UI</p>
      <div class="skills__list">
        <span class="skills__item">Microfrontends · Module Federation</span>
        <span class="skills__item">PWA · Componentes reutilizables</span>
        <span class="skills__item">API Gateway · Proxy</span>
        <span class="skills__item">Material UI · Bootstrap 4</span>
        <span class="skills__item">AG Grid · react-window</span>
        <span class="skills__item skills__item--last">Diseño responsivo</span>
      </div>
    </div>

    <div class="skills__category">
      <p class="skills__category-label">// backend e integración</p>
      <div class="skills__list">
        <span class="skills__item">Node.js · Express</span>
        <span class="skills__item">APIs REST · Axios</span>
        <span class="skills__item">Observables · WebSockets · Socket.io</span>
        <span class="skills__item">JWT · Integración con .NET</span>
        <span class="skills__item skills__item--last">RethinkDB · MySQL</span>
      </div>
    </div>

    <div class="skills__category">
      <p class="skills__category-label">// calidad y colaboración</p>
      <div class="skills__list">
        <span class="skills__item">Pruebas unitarias · Kiuwan</span>
        <span class="skills__item">Git · GitHub · CI/CD</span>
        <span class="skills__item">Múltiples entornos de despliegue</span>
        <span class="skills__item">Español nativo · Inglés básico</span>
        <span class="skills__item skills__item--last">
          Trabajo con equipos de producto y diseño
        </span>
      </div>
    </div>
  </div>
</section>
