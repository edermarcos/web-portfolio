---
// Skills.astro
import './Skills.css';
---

<section id="habilidades" class="skills">
  <div class="skills__header">
    <span class="skills__number">01</span>
    <h2 class="skills__title">Habilidades</h2>
    <span class="skills__comment">// herramientas con las que trabajo a diario</span>
  </div>

  <div class="skills__grid">
    <div class="skills__category">
      <p class="skills__category-label">// frontend</p>
      <div class="skills__list">
        <span class="skills__item">JavaScript</span>
        <span class="skills__item">TypeScript</span>
        <span class="skills__item">Angular</span>
        <span class="skills__item">React</span>
        <span class="skills__item">Astro</span>
        <span class="skills__item">HTML5 · CSS3 · SCSS</span>
        <span class="skills__item">Bootstrap · Material UI</span>
        <span class="skills__item skills__item--last">Ionic</span>
      </div>
    </div>

    <div class="skills__category">
      <p class="skills__category-label">// backend</p>
      <div class="skills__list">
        <span class="skills__item">Node.js</span>
        <span class="skills__item">Express.js</span>
        <span class="skills__item">Nest.js</span>
        <span class="skills__item">Socket.io</span>
        <span class="skills__item">RethinkDB</span>
        <span class="skills__item skills__item--last">REST APIs</span>
      </div>
    </div>

    <div class="skills__category">
      <p class="skills__category-label">// herramientas & metodologías</p>
      <div class="skills__list">
        <span class="skills__item">Git · GitHub</span>
        <span class="skills__item">Metodologías ágiles</span>
        <span class="skills__item">Module Federation</span>
        <span class="skills__item">NgrX</span>
      </div>
    </div>
  </div>
</section>


