---
// Projects.astro
import './Projects.css';
---

<section id="proyectos" class="projects">
  <div class="projects__header">
    <span class="projects__number">02</span>
    <h2 class="projects__title">Proyectos</h2>
  </div>

  <a href="#" class="project project--featured">
    <span class="project__number">01</span>
    <div class="project__content">
      <h3 class="project__title">Intranet</h3>
      <p class="project__description">
        Aplicación web concebida para gestionar datos de empleados y controlar solicitudes de vacaciones y permisos. La incorporación de módulos adicionales la convirtió en una herramienta versátil que aborda diversas necesidades empresariales, desde la administración de recursos humanos hasta funciones más allá de la gestión de datos.
      </p>
      <div class="project__tags">
        <span class="project__tag">Angular</span>
        <span class="project__tag">Bootstrap 4</span>
        <span class="project__tag">Socket.io</span>
        <span class="project__tag">SCSS</span>
        <span class="project__tag">Node.js</span>
        <span class="project__tag">RethinkDB</span>
        <span class="project__tag">Express.js</span>
      </div>
    </div>
    <span class="project__cta">Ver proyecto →</span>
  </a>

