---
import './Hero.css';
---

<section id="inicio" class="hero">
  <div class="hero__grid">
    <div class="hero__content">
      <div class="hero__badge">
        <span class="hero__badge-dot"></span>
        Disponible para proyectos
      </div>
      <h1 class="hero__title">Eder Marcos.</h1>
      <p class="hero__subtitle">Senior Front-End Engineer</p>
      <p class="hero__description">
        Desarrollador Front-End Senior con más de 8 años de experiencia creando aplicaciones web
        escalables con Angular y React. Especializado en microfrontends, rendimiento e integración
        de APIs REST, con experiencia full-stack en Node.js.
      </p>
      <div class="hero__ctas">
        <a href="/15OCT26_eder_marcos_cv.pdf" download class="hero__cta hero__cta--primary">
          Descargar CV →
        </a>
        <a href="#proyectos" class="hero__cta hero__cta--secondary">
          Ver proyectos
        </a>
      </div>
    </div>

    <div class="hero__code-card">
      <div class="hero__code-header">
        <span class="hero__code-dot"></span>
        <span class="hero__code-dot"></span>
        <span class="hero__code-dot"></span>
        <span class="hero__code-filename">index.js</span>
      </div>
      <pre class="hero__code"><span class="keyword">const</span> <span class="variable">eder</span> = &#123;
  rol: <span class="string">'Senior Front-End Engineer'</span>,
  base: <span class="string">'JavaScript/TypeScript'</span>,
  frontend: [<span class="string">'Angular'</span>, <span class="string">'React'</span>],
  arquitectura: [<span class="string">'Microfrontends'</span>, <span class="string">'Module Federation'</span>],
  backend: [<span class="string">'Node.js'</span>, <span class="string">'Express'</span>],
  enfoque: <span class="string">'Rendimiento y escalabilidad'</span>,
&#125;;</pre>
    </div>
  </div>
</section>
