---
import './Footer.css';
---

<footer id="contacto" class="footer">
  <div class="footer__header">
    <p class="footer__label">// contacto</p>
    <h2 class="footer__title">¿Construimos algo juntos?</h2>
    <p class="footer__location">Querétaro, México · Disponible para colaborar de forma remota</p>
  </div>

  <div class="footer__channels">
    <a
      href="https://wa.me/524427842440?text=Hola%2C%20vi%20tu%20portafolio%20y%20me%20gustar%C3%ADa%20conversar%20sobre%20un%20proyecto."
      class="footer__channel footer__channel--whatsapp"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="footer__channel-label">WhatsApp</span>
      <span class="footer__channel-value">+52 442 784 2440</span>
      <span class="footer__channel-arrow" aria-hidden="true">
        ↗
      </span>
    </a>
    <a href="mailto:eder.marcos.lara@gmail.com" class="footer__channel footer__channel--email">
      <span class="footer__channel-label">Correo electrónico</span>
      <span class="footer__channel-value">eder.marcos.lara@gmail.com</span>
      <span class="footer__channel-note">Enviar correo</span>
    </a>
  </div>

  <div class="footer__socials">
    <h3 class="footer__social-title">También puedes encontrarme en</h3>
    <ul class="footer__links">
      <li>
        <a
          class="footer__link"
          href="https://github.com/edermarcos"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub <small>github.com/edermarcos</small>
        </a>
      </li>
      <li>
        <a
          class="footer__link"
          href="https://www.linkedin.com/in/edermarcos/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn <small>linkedin.com/in/edermarcos</small>
        </a>
      </li>
      <li>
        <a
          class="footer__link"
          href="https://www.instagram.com/iedermarcos/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram <small>instagram.com/iedermarcos</small>
        </a>
      </li>
      <li>
        <a
          class="footer__link"
          href="https://www.tiktok.com/@iedermarcos"
          target="_blank"
          rel="noopener noreferrer"
        >
          TikTok <small>tiktok.com/@iedermarcos</small>
        </a>
      </li>
    </ul>
  </div>

  <div class="footer__bottom">
    <span class="footer__copyright">© 2026 Jose Eder Marcos Lara</span>
    <a class="footer__back-to-top" href="#inicio">
      Volver al inicio ↑
    </a>
  </div>

  <div class="footer__watermark">
    Sitio web desarrollado por <a href="#em-dev-studio">EM Dev Studio</a>
  </div>
</footer>
