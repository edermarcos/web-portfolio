---
import type { ProjectFiltersProps } from '../types/project';

const { years, technologies } = Astro.props as ProjectFiltersProps;
---

<div class="projects__filters">
  <div class="projects__filter">
    <label class="projects__filters-label" for="projectYearFilter">
      Año
    </label>
    <select class="projects__filter-select" id="projectYearFilter">
      <option value="">Todos los años</option>
      {years.map((year) => (
        <option value={year}>{year}</option>
      ))}
    </select>
  </div>
  <div class="projects__filter">
    <label class="projects__filters-label" for="projectTechnologyFilter">
      Tecnología
    </label>
    <select class="projects__filter-select" id="projectTechnologyFilter">
      <option value="">Todas las tecnologías</option>
      {technologies.map((technology) => (
        <option value={technology}>{technology}</option>
      ))}
    </select>
  </div>
</div>
